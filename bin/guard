#!/bin/bash
# Entry point for bin/guard.php — finds a PHP binary and gives it a PATH
# that has cPanel's own tools on it. cron runs jobs with a bare
# /sbin:/bin:/usr/sbin:/usr/bin, which has no whmapi1, and a scan that
# cannot list accounts scans nothing.
set -euo pipefail

INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

for d in /usr/local/cpanel/bin /usr/local/cpanel/scripts /usr/local/bin /usr/local/sbin /usr/sbin /usr/bin /sbin /bin; do
  case ":$PATH:" in
    *":$d:"*) ;;
    *) if [ -d "$d" ]; then PATH="$PATH:$d"; fi ;;
  esac
done
export PATH

# The CLI binary specifically. On some servers `php` is php-cgi, which
# ignores the script it is given when it finds CGI variables around it, and
# guard.php refuses to run under anything but the CLI.
is_cli() { [ -x "$1" ] && [ "$("$1" -n -r 'echo PHP_SAPI;' 2>/dev/null)" = "cli" ]; }
PHP_BIN=""
for c in "${SG_PHP:-}" "$(command -v php 2>/dev/null || true)" /usr/local/bin/php /usr/bin/php \
         /opt/cpanel/ea-php*/root/usr/bin/php /usr/local/cpanel/3rdparty/bin/php; do
  if [ -n "$c" ] && is_cli "$c"; then PHP_BIN="$c"; break; fi
done
if [ -z "$PHP_BIN" ]; then
  echo "[$(date '+%F %T')] [!] No PHP command-line binary found — Storage Guard cannot run." >> /var/log/skyserver-storage-guard.log
  echo "No PHP command-line binary found." >&2
  exit 1
fi

exec "$PHP_BIN" -d display_errors=stderr -d memory_limit=512M -d disable_functions= -d open_basedir= "$INSTALL_DIR/bin/guard.php" "$@"
